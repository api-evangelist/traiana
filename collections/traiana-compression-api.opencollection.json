              },
              {
                "name": "fromDate",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieves trade compression runs that aggregate trades for each currency pair at user-defined intervals."
        },
        {
          "info": {
            "name": "Create a Compression Run",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.traiana.com/creditlink/v1/compression-runs",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiates a trade compression run to aggregate trades by currency pair."
        }
      ]
    }
  ],
  "bundled": true
}