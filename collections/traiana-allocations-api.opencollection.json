              },
              {
                "name": "fromDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "toDate",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieves trade allocations, including block-level and allocation-level details from executing brokers and investment managers."
        },
        {
          "info": {
            "name": "Submit an Allocation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.traiana.com/creditlink/v1/allocations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submits a trade allocation for processing through the Harmony network."
        }
      ]
    }
  ],
  "bundled": true
}