{
  "opencollection": "1.0.0",
  "info": {
    "name": "Traiana Harmony CreditLink Allocations Matching API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Matching",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Match Results",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.traiana.com/creditlink/v1/matching",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "fromDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "toDate",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieves trade matching results processed by the Harmony cross-asset matching engine."
        }
      ]
    }
  ],
  "bundled": true
}